# Set these in your shell, or add the selected API key as a GitHub Actions secret.
# The application intentionally does not auto-load .env files.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free-tier AI summaries (Google AI Studio) and reliable OpenAlex citation alerts.
GEMINI_API_KEY=
OPENALEX_API_KEY=
# Optional overrides; leave LLM_MODEL unset to use the provider's default.
LLM_PROVIDER=gemini
